{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid == $uid",
        ".validate": "newData.hasChildren(['uid','username','displayName','photoURL','createdAt']) && newData.child('uid').val() == $uid && newData.child('username').isString() && newData.child('displayName').isString() && newData.child('displayName').val().length >= 1 && newData.child('displayName').val().length <= 40 && newData.child('photoURL').isString() && newData.child('createdAt').isNumber()"
      }
    },
    "usernames": {
      "$username": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() && newData.val() == auth.uid || data.val() == auth.uid)",
        ".validate": "newData.isString() && newData.val().length >= 3"
      }
    },
    "friends": {
      "$uid": {
        "$friendUid": {
          ".read": "auth != null && auth.uid == $uid",
          ".write": "auth != null && (auth.uid == $uid || auth.uid == $friendUid)"
        }
      }
    },
    "friendships": {
      "$friendshipId": {
        ".read": "auth != null && (data.child('participants').child('0').val() == auth.uid || data.child('participants').child('1').val() == auth.uid)",
        ".write": "auth != null && (data.child('participants').child('0').val() == auth.uid || data.child('participants').child('1').val() == auth.uid || (!data.exists() && (newData.child('participants').child('0').val() == auth.uid || newData.child('participants').child('1').val() == auth.uid)))",
        ".validate": "newData.hasChildren(['participants','since']) && newData.child('participants').hasChildren(['0','1']) && newData.child('since').isNumber()"
      }
    },
    "userChats": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        "$roomId": {
          ".write": "auth != null && auth.uid == $uid",
          ".validate": "newData.hasChildren(['roomId','otherUid','lastMessageAt'])"
        }
      }
    },
    "friendRequests": {
      "$requestId": {
        ".read": "auth != null && (data.child('fromUid').val() == auth.uid || data.child('toUid').val() == auth.uid)",
        ".write": "auth != null && (!data.exists() && newData.child('fromUid').val() == auth.uid || data.child('fromUid').val() == auth.uid || data.child('toUid').val() == auth.uid)",
        ".validate": "newData.hasChildren(['fromUid','toUid','status','createdAt']) && newData.child('fromUid').isString() && newData.child('toUid').isString() && newData.child('status').isString() && newData.child('createdAt').isNumber()"
      }
    },
    "chatMeta": {
      "$roomId": {
        ".read": "auth != null && (data.child('participants').child('0').val() == auth.uid || data.child('participants').child('1').val() == auth.uid)",
        ".write": "auth != null && (data.child('participants').child('0').val() == auth.uid || data.child('participants').child('1').val() == auth.uid || (!data.exists() && (newData.child('participants').child('0').val() == auth.uid || newData.child('participants').child('1').val() == auth.uid)))",
        ".validate": "newData.hasChildren(['roomId','participants','lastMessageAt']) && newData.child('roomId').isString() && newData.child('lastMessageAt').isNumber()",
        "unreadCounts": {
          "$uid": {
            ".write": "auth != null && (root.child('chatMeta').child($roomId).child('participants').child('0').val() == auth.uid || root.child('chatMeta').child($roomId).child('participants').child('1').val() == auth.uid)",
            ".validate": "newData.isNumber()"
          }
        }
      }
    },
    "rooms": {
      "$roomId": {
        "meta": {
          ".read": "auth != null && (!data.exists() || data.child('participants').child('0').val() == auth.uid || data.child('participants').child('1').val() == auth.uid)",
          ".write": "auth != null && ((!data.exists() && newData.exists() && (newData.child('participants').child('0').val() == auth.uid || newData.child('participants').child('1').val() == auth.uid)) || (data.exists() && (data.child('participants').child('0').val() == auth.uid || data.child('participants').child('1').val() == auth.uid)))",
          ".validate": "newData.hasChildren(['participants','keyCheck']) && newData.child('participants').hasChildren(['0','1']) && !newData.child('participants').child('2').exists() && newData.child('participants').child('0').isString() && newData.child('participants').child('1').isString() && newData.child('participants').child('0').val() != newData.child('participants').child('1').val() && newData.child('keyCheck').hasChildren(['ciphertext','iv']) && newData.child('keyCheck').child('ciphertext').isString() && newData.child('keyCheck').child('iv').isString()",
          "participants": {
            "$participantId": {
              ".validate": "$participantId == '0' || $participantId == '1'"
            }
          },
          "mode": {
            ".write": "auth != null && (root.child('rooms').child($roomId).child('meta').child('participants').child('0').val() == auth.uid || root.child('rooms').child($roomId).child('meta').child('participants').child('1').val() == auth.uid)",
            ".validate": "newData.isString() && (newData.val() == 'NORMAL' || newData.val() == 'GHOST' || newData.val() == 'BURST' || newData.val() == 'VAULT' || newData.val() == 'STEALTH' || newData.val() == 'LIVE')"
          }
        },
        "messages": {
          ".read": "auth != null && (root.child('rooms').child($roomId).child('meta').child('participants').child('0').val() == auth.uid || root.child('rooms').child($roomId).child('meta').child('participants').child('1').val() == auth.uid)",
          "$messageId": {
            ".read": "auth != null && (root.child('rooms').child($roomId).child('meta').child('participants').child('0').val() == auth.uid || root.child('rooms').child($roomId).child('meta').child('participants').child('1').val() == auth.uid)",
            ".write": "auth != null && (root.child('rooms').child($roomId).child('meta').child('participants').child('0').val() == auth.uid || root.child('rooms').child($roomId).child('meta').child('participants').child('1').val() == auth.uid) && ((!data.exists() && newData.exists() && newData.child('senderId').val() == auth.uid) || (data.exists() && !newData.exists()) || (data.exists() && newData.exists()))",
            ".validate": "newData.hasChildren(['ciphertext','iv','senderId','timestamp']) && newData.child('ciphertext').isString() && newData.child('iv').isString() && newData.child('senderId').isString() && newData.child('timestamp').isNumber() && (!newData.hasChild('expiresAt') || newData.child('expiresAt').isNumber()) && (!newData.hasChild('mediaType') || (newData.child('mediaType').isString() && (newData.child('mediaType').val() == 'image' || newData.child('mediaType').val() == 'video'))) && (!newData.hasChild('mediaData') == !newData.hasChild('mediaIv')) && (!newData.hasChild('mediaData') || newData.child('mediaData').isString()) && (!newData.hasChild('mediaIv') || newData.child('mediaIv').isString())",
            "reactions": {
              "$uid": {
                ".write": "auth != null && $uid == auth.uid && (root.child('rooms').child($roomId).child('meta').child('participants').child('0').val() == auth.uid || root.child('rooms').child($roomId).child('meta').child('participants').child('1').val() == auth.uid)",
                ".validate": "newData.isString() && newData.val().length <= 10"
              }
            },
            "readBy": {
              "$uid": {
                ".write": "auth != null && $uid == auth.uid && (root.child('rooms').child($roomId).child('meta').child('participants').child('0').val() == auth.uid || root.child('rooms').child($roomId).child('meta').child('participants').child('1').val() == auth.uid)",
                ".validate": "newData.isNumber()"
              }
            },
            "deletedFor": {
              "$uid": {
                ".write": "auth != null && $uid == auth.uid && (root.child('rooms').child($roomId).child('meta').child('participants').child('0').val() == auth.uid || root.child('rooms').child($roomId).child('meta').child('participants').child('1').val() == auth.uid)",
                ".validate": "newData.isBoolean()"
              }
            }
          }
        },
        "moments": {
          "$momentId": {
            ".read": "auth != null && (root.child('rooms').child($roomId).child('meta').child('participants').child('0').val() == auth.uid || root.child('rooms').child($roomId).child('meta').child('participants').child('1').val() == auth.uid)",
            ".write": "auth != null && (root.child('rooms').child($roomId).child('meta').child('participants').child('0').val() == auth.uid || root.child('rooms').child($roomId).child('meta').child('participants').child('1').val() == auth.uid)",
            ".validate": "newData.hasChildren(['ciphertext','iv','senderId','expiresAt']) && newData.child('ciphertext').isString() && newData.child('iv').isString() && newData.child('senderId').val() == auth.uid && newData.child('expiresAt').isNumber()"
          }
        },
        "presence": {
          "$uid": {
            ".read": "auth != null && (root.child('rooms').child($roomId).child('meta').child('participants').child('0').val() == auth.uid || root.child('rooms').child($roomId).child('meta').child('participants').child('1').val() == auth.uid)",
            ".write": "auth != null && $uid == auth.uid && (root.child('rooms').child($roomId).child('meta').child('participants').child('0').val() == auth.uid || root.child('rooms').child($roomId).child('meta').child('participants').child('1').val() == auth.uid)",
            ".validate": "newData.hasChildren(['typing','at']) && newData.child('typing').isBoolean() && newData.child('at').isNumber()"
          }
        },
        ".read": "false",
        ".write": "false"
      }
    }
  }
}
